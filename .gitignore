# Python build and runtime files
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Node and Studio build output
node_modules/
studio/node_modules/
studio/.next/
studio/.next*/
studio/test-results/
studio/playwright-report/
.pnpm-store/
.deps/

# Local AgentForge state and generated customer projects
.agentforge-server/
workspaces/
supabase/.temp/

# Local environment and runtime logs
.env
.env.*
!.env.example
*.log
*.out
*.err
*.pid
*.sqlite
*.sqlite-*

# Local archives and generated artifacts
*.rar
*.zip

# Licence-controlled public SRS corpus downloads; provenance receipts remain
# local with the archive and are regenerated by tools/srs_corpus.py.
srs-test-sources/srs-data/*
!srs-test-sources/srs-data/README.md

# Desktop app builds
studio/out/
desktop/dist/
release/stage/
release/out/
release/installer/Config.generated.cs
release/cache/
engine-proxy/.wrangler/
engine-proxy/.dev.vars

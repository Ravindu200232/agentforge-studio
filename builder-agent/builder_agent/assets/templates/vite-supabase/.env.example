# AgentForge sets these from the project's own connected Supabase project (Build setup -> pick a
# Supabase stack) every time it runs a command here - nobody pastes them. This file only documents
# the shape, for running a command outside the Studio: copy it to .env.local and fill in the real
# values from your Supabase project's Settings -> API page.
#
# There is no service-role key here on purpose: this app has no server, every VITE_* variable is
# compiled into the public bundle, and the service-role key must never reach a browser. Row Level
# Security, not a hidden key, is what protects this app's data.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=<project settings -> API -> anon public>

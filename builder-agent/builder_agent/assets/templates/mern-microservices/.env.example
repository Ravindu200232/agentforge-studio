# Local UI preview and the API gateway use different ports.
VITE_PORT=5173
PORT=4000
# Local development and tests only. The deployed services are given a real,
# internet-reachable connection string (MongoDB Atlas or any host that is not
# this computer) at deploy time - never a loopback address like this one.
MONGODB_URI=mongodb://127.0.0.1:27017/__APP_DB__
# Internal service ports. Nothing outside the machine uses these.
CATALOG_PORT=4001

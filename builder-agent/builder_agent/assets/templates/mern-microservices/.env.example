# Local UI preview and the API gateway use different ports.
VITE_PORT=5173
PORT=4000
# The Studio sets MONGODB_URI (and TEST_MONGODB_URI, for the unit tests) in the environment of
# every command and of the preview, from the customer's connected MongoDB cluster: do not copy
# this file to .env to point the app at a database. The address below is only the template's
# last resort for a computer with no connection; a deployed application is given the real one.
MONGODB_URI=mongodb://127.0.0.1:27017/__APP_DB__
# Internal service ports. Nothing outside the machine uses these.
CATALOG_PORT=4001

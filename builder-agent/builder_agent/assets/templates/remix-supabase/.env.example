# AgentForge sets these from the project's own connected Supabase project (Build setup -> pick a
# Supabase stack) every time it runs a command here - nobody pastes them. This file only documents
# the shape, for running a command outside the Studio: copy it to .env and fill in the real values
# from your Supabase project's Settings -> API page.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=<project settings -> API -> anon public>
SUPABASE_SERVICE_ROLE_KEY=<project settings -> API -> service_role - server only>

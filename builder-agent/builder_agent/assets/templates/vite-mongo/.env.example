# The public port Vite serves the client on during local development.
VITE_PORT=5174
# The API server's port, local and in production alike.
PORT=4100
# Local development and `npm test` only. The deployed server is given a real,
# internet-reachable connection string (MongoDB Atlas or any host that is not
# this computer) at deploy time - never a loopback address like this one.
MONGODB_URI=mongodb://127.0.0.1:27017/__APP_DB__

            "refs/remotes",
            "--format=%(refname:short)%09%(objectname:short)%09%(committerdate:iso-strict)%09%(upstream:short)%09%(HEAD)%09%(subject)"
          ]
        },
        {
          "id": "gh-tags",
          "group": "History",
          "label": "Tags",
          "tool": "git",
          "argv": [
            "for-each-ref",
            "refs/tags",

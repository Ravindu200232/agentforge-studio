            "name,nameWithOwner,description,visibility,url,defaultBranchRef,pushedAt,createdAt,updatedAt,stargazerCount,forkCount,isPrivate,primaryLanguage,languages,licenseInfo,homepageUrl,repositoryTopics,diskUsage,owner"
          ]

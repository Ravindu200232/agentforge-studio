            "repos/{{repository.url:slug}}/collaborators"
          ]
        },
        {
          "id": "gh-commits",
          "group": "History",
          "label": "Commits",
          "tool": "git",
          "argv": [
            "log",
            "-40",
            "--date=iso-strict",
            "--pretty=format:%H%x09%h%x09%an%x09%ae%x09%aI%x09%D%x09%s"
          ]
        },
        {
          "id": "gh-branches",
          "group": "History",
          "label": "Branches",
          "tool": "git",
          "argv": [

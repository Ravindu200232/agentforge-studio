    "netlify": {
      "tool": "netlify",
      "title": "Netlify CLI",
      "commands": [
        {
          "id": "netlify-account",
          "group": "Account",
          "label": "Account",
          "argv": [
            "status",
            "--json"
          ]
        },
        {
          "id": "sites",
          "group": "Account",
          "label": "All sites",
          "argv": [
            "sites:list",
            "--json"
          ]
        },
        {
          "id": "site",
          "group": "Site",
          "label": "Site",
          "argv": [
            "api",
            "getSite",
            "--data",
            "{\"site_id\":\"{{host.site_id}}\"}"
          ]
        },
        {
          "id": "deploys",
          "group": "Deployments",
          "label": "Deploys",
          "argv": [
            "api",
            "listSiteDeploys",
            "--data",
            "{\"site_id\":\"{{host.site_id}}\"}"
          ]
        },
        {
          "id": "site-deploy",
          "group": "Deployments",
          "label": "Deploy",
          "argv": [
            "api",
            "getSiteDeploy",
            "--data",
            "{\"site_id\":\"{{host.site_id}}\",\"deploy_id\":\"{{host.deploy_id}}\"}"
          ]
        },
        {
          "id": "builds",
          "group": "Deployments",
          "label": "Builds",
          "argv": [
            "api",
            "listSiteBuilds",
            "--data",
            "{\"site_id\":\"{{host.site_id}}\"}"
          ]
        },
        {
          "id": "functions",
          "group": "Configuration",
          "label": "Functions",
          "argv": [
            "functions:list",
            "--json"
          ]
        },
        {
          "id": "forms",
          "group": "Configuration",
          "label": "Forms",
          "argv": [
            "api",
            "listSiteForms",
            "--data",
            "{\"site_id\":\"{{host.site_id}}\"}"
          ]
        }
      ]
    },
    "aws-account": {
      "tool": "aws",
      "title": "AWS CLI",
      "common": [
        "--profile",
        "{{setting.aws_profile}}",
        "--region",
        "{{host.region|setting.aws_region}}"
      ],
      "commands": [
        {
          "id": "aws-account",
          "group": "Account",
          "label": "Account",
          "argv": [
            "sts",
            "get-caller-identity",
            "--output",
            "json"
          ]
        },
        {
          "id": "stack",
          "group": "Stack",
          "label": "Stack",
          "argv": [
            "cloudformation",
            "describe-stacks",
            "--stack-name",
            "{{host.stack_name}}",
            "--query",
            "Stacks[0].{Name:StackName,Status:StackStatus,Created:CreationTime,Updated:LastUpdatedTime,Outputs:Outputs}",
            "--output",
            "json"
          ]
        },
        {
          "id": "stack-resources",
          "group": "Stack",
          "label": "Resources",
          "argv": [
            "cloudformation",
            "describe-stack-resources",
            "--stack-name",
            "{{host.stack_name}}",
            "--query",
            "StackResources[].{Logical:LogicalResourceId,Type:ResourceType,Status:ResourceStatus,Id:PhysicalResourceId}",
            "--output",
            "json"
          ]
        },
        {
          "id": "stack-events",
          "group": "Stack",
          "label": "Stack events",
          "argv": [
            "cloudformation",
            "describe-stack-events",
            "--stack-name",
            "{{host.stack_name}}",
            "--max-items",
            "40",
            "--query",
            "StackEvents[].{Time:Timestamp,Resource:LogicalResourceId,Status:ResourceStatus,Reason:ResourceStatusReason}",
            "--output",
            "json"
          ]
        },
        {
          "id": "cdn",
          "group": "Network",
          "label": "CloudFront",
          "argv": [
            "cloudfront",
            "get-distribution",
            "--id",
            "{{host.distribution_id}}",
            "--query",
            "Distribution.{Id:Id,Status:Status,Domain:DomainName,Enabled:DistributionConfig.Enabled,Aliases:DistributionConfig.Aliases.Items}",
            "--output",
            "json"
          ]
        },
        {
          "id": "alarms",
          "group": "Monitoring",
          "label": "Alarms",
          "argv": [
            "cloudwatch",
            "describe-alarms",
            "--alarm-name-prefix",
            "{{host.stack_name}}",
            "--query",
            "MetricAlarms[].{Name:AlarmName,State:StateValue,Metric:MetricName,Reason:StateReason,Updated:StateUpdatedTimestamp}",
            "--output",
            "json"
          ]
        }
      ]
    },
    "aws-ec2": {
      "tool": "aws",
      "title": "AWS CLI",
      "common": [
        "--profile",
        "{{setting.aws_profile}}",
        "--region",
        "{{host.region|setting.aws_region}}"
      ],
      "commands": [
        {
          "id": "instance",
          "group": "Instance",
          "label": "Instance",
          "argv": [
            "ec2",
            "describe-instances",
            "--instance-ids",
            "{{host.instance_id}}",
            "--query",
            "Reservations[].Instances[].{Id:InstanceId,Type:InstanceType,State:State.Name,PublicIp:PublicIpAddress,Launched:LaunchTime,Az:Placement.AvailabilityZone}",
            "--output",
            "json"
          ]
        },
        {
          "id": "health",
          "group": "Instance",
          "label": "Health checks",
          "argv": [
            "ec2",
            "describe-instance-status",
            "--instance-ids",
            "{{host.instance_id}}",
            "--include-all-instances",
            "--query",
            "InstanceStatuses[].{Id:InstanceId,State:InstanceState.Name,System:SystemStatus.Status,Instance:InstanceStatus.Status}",
            "--output",
            "json"
          ]
        },
        {
          "id": "volumes",
          "group": "Instance",
          "label": "Volumes",
          "argv": [
            "ec2",
            "describe-volumes",
            "--filters",
            "Name=attachment.instance-id,Values={{host.instance_id}}",
            "--query",
            "Volumes[].{Id:VolumeId,Size:Size,Type:VolumeType,State:State,Encrypted:Encrypted,Iops:Iops}",
            "--output",
            "json"
          ]
        },
        {
          "id": "addresses",
          "group": "Instance",
          "label": "Elastic IPs",
          "argv": [
            "ec2",
            "describe-addresses",
            "--filters",
            "Name=instance-id,Values={{host.instance_id}}",
            "--query",
            "Addresses[].{Ip:PublicIp,Allocation:AllocationId,Association:AssociationId,Instance:InstanceId}",
            "--output",
            "json"
          ]
        },
        {
          "id": "ssm",
          "group": "Releases",
          "label": "SSM agent",
          "argv": [
            "ssm",
            "describe-instance-information",
            "--filters",
            "Key=InstanceIds,Values={{host.instance_id}}",
            "--query",
            "InstanceInformationList[].{Id:InstanceId,Ping:PingStatus,Agent:AgentVersion,Platform:PlatformName,LastPing:LastPingDateTime}",
            "--output",
            "json"
          ]
        },
        {
          "id": "ssm-history",
          "group": "Releases",
          "label": "Release commands",
          "argv": [
            "ssm",
            "list-command-invocations",
            "--instance-id",
            "{{host.instance_id}}",
            "--max-items",
            "15",
            "--query",
            "CommandInvocations[].{Command:CommandId,Document:DocumentName,Status:Status,Requested:RequestedDateTime,Comment:Comment}",
            "--output",
            "json"
          ]
        },
        {
          "id": "releases",
          "group": "Releases",
          "label": "Release artifacts",
          "argv": [
            "s3",
            "ls",
            "s3://{{host.bucket}}/releases/",
            "--recursive",
            "--human-readable"
          ]
        },
        {
          "id": "secrets",
          "group": "Configuration",
          "label": "Secrets (names)",
          "argv": [
            "secretsmanager",
            "list-secrets",
            "--filters",
            "Key=name,Values={{host.secret_name|host.log_group|host.stack_name}}",
            "--query",
            "SecretList[].{Name:Name,Changed:LastChangedDate,Accessed:LastAccessedDate,Rotation:RotationEnabled}",
            "--output",
            "json"
          ]
        },
        {
          "id": "ec2-logs",
          "group": "Logs",
          "label": "Live logs",
          "follow": true,
          "timeout": 600,
          "argv": [
            "logs",
            "tail",
            "{{host.log_group}}",
            "--follow",
            "--since",
            "30m",
            "--format",
            "short"
          ]
        }
      ]
    },
    "aws-ecs": {
      "tool": "aws",
      "title": "AWS CLI",
      "common": [
        "--profile",
        "{{setting.aws_profile}}",
        "--region",
        "{{host.region|setting.aws_region}}"
      ],
      "commands": [
        {
          "id": "cluster",
          "group": "Cluster",
          "label": "Cluster",
          "argv": [
            "ecs",
            "describe-clusters",
            "--clusters",
            "{{host.cluster}}",
            "--query",
            "clusters[].{Name:clusterName,Status:status,Services:activeServicesCount,Running:runningTasksCount,Pending:pendingTasksCount}",
            "--output",
            "json"
          ]
        },
        {
          "id": "service",
          "group": "Cluster",
          "label": "Service",
          "argv": [
            "ecs",
            "describe-services",
            "--cluster",
            "{{host.cluster}}",
            "--services",
            "{{host.service}}",
            "--query",
            "services[].{Name:serviceName,Status:status,Desired:desiredCount,Running:runningCount,Pending:pendingCount,TaskDefinition:taskDefinition,Deployments:deployments[].{State:rolloutState,Desired:desiredCount,Running:runningCount}}",
            "--output",
            "json"
          ]
        },
        {
          "id": "service-events",
          "group": "Cluster",
          "label": "Service events",
          "argv": [
            "ecs",
            "describe-services",
            "--cluster",
            "{{host.cluster}}",
            "--services",
            "{{host.service}}",
            "--query",
            "services[0].events[:20].{Time:createdAt,Message:message}",
            "--output",
            "json"
          ]
        },
        {
          "id": "tasks",
          "group": "Cluster",
          "label": "Tasks",
          "argv": [
            "ecs",
            "list-tasks",
            "--cluster",
            "{{host.cluster}}",
            "--service-name",
            "{{host.service}}",
            "--output",
            "json"
          ]
        },
        {
          "id": "task-definition",
          "group": "Cluster",
          "label": "Task definition",
          "argv": [
            "ecs",
            "describe-task-definition",
            "--task-definition",
            "{{host.task_definition}}",
            "--query",
            "taskDefinition.{Family:family,Revision:revision,Cpu:cpu,Memory:memory,Containers:containerDefinitions[].{Name:name,Image:image,Port:portMappings[0].containerPort,Variables:environment[].name,Secrets:secrets[].name}}",
            "--output",
            "json"
          ]
        },
        {
          "id": "scaling",
          "group": "Cluster",
          "label": "Auto scaling",
          "argv": [
            "application-autoscaling",
            "describe-scalable-targets",
            "--service-namespace",
            "ecs",
            "--resource-ids",
            "service/{{host.cluster}}/{{host.service}}",
            "--query",
            "ScalableTargets[].{Resource:ResourceId,Min:MinCapacity,Max:MaxCapacity,Dimension:ScalableDimension}",
            "--output",
            "json"
          ]
        },
        {
          "id": "target-health",
          "group": "Network",
          "label": "Target health",
          "argv": [
            "elbv2",
            "describe-target-health",
            "--target-group-arn",
            "{{host.target_group_arn}}",
            "--query",
            "TargetHealthDescriptions[].{Target:Target.Id,Port:Target.Port,State:TargetHealth.State,Reason:TargetHealth.Reason}",
            "--output",
            "json"
          ]
        },
        {
          "id": "images",
          "group": "Releases",
          "label": "Images",
          "argv": [
            "ecr",
            "describe-images",
            "--repository-name",
            "{{host.repository_name}}",
            "--query",
            "sort_by(imageDetails,&imagePushedAt)[-10:].{Tags:imageTags,Pushed:imagePushedAt,SizeBytes:imageSizeInBytes}",
            "--output",
            "json"
          ]
        },
        {
          "id": "image-builds",
          "group": "Releases",
          "label": "Image builds",
          "argv": [
            "codebuild",
            "list-builds-for-project",
            "--project-name",
            "{{host.build_project}}",
            "--max-items",
            "10",
            "--output",
            "json"
          ]
        },
        {
          "id": "secrets",
          "group": "Configuration",
          "label": "Secrets (names)",
          "argv": [
            "secretsmanager",
            "list-secrets",
            "--filters",
            "Key=name,Values={{host.secret_name|host.log_group|host.stack_name}}",
            "--query",
            "SecretList[].{Name:Name,Changed:LastChangedDate,Accessed:LastAccessedDate,Rotation:RotationEnabled}",
            "--output",
            "json"
          ]
        },
        {
          "id": "ecs-logs",
          "group": "Logs",
          "label": "Live logs",
          "follow": true,
          "timeout": 600,
          "argv": [
            "logs",
            "tail",
            "{{host.log_group}}",
            "--follow",
            "--since",
            "30m",
            "--format",
            "short"
          ]
        }
      ]
    },
    "azure": {
      "tool": "az",
      "title": "Azure CLI",
      "commands": [
        {
          "id": "azure-account",
          "group": "Account",
          "label": "Account",
          "argv": [
            "account",
            "show",
            "--query",
            "{User:user.name,Subscription:name,Id:id,Tenant:tenantId}",
            "--output",
            "json"
          ]
        },
        {
          "id": "resources",
          "group": "Resources",
          "label": "Resources",
          "argv": [
            "resource",
            "list",
            "--resource-group",
            "{{host.resource_group}}",
            "--query",
            "[].{Name:name,Type:type,Location:location}",
            "--output",
            "json"
          ]
        },
        {
          "id": "app",
          "group": "Web app",
          "label": "Web app",
          "argv": [
            "webapp",
            "show",
            "--resource-group",
            "{{host.resource_group}}",
            "--name",
            "{{host.app}}",
            "--query",
            "{Name:name,State:state,Host:defaultHostName,HttpsOnly:httpsOnly,Kind:kind,Location:location,OutboundIps:outboundIpAddresses}",
            "--output",
            "json"
          ]
        },
        {
          "id": "plan",
          "group": "Web app",
          "label": "Plan & size",
          "argv": [
            "appservice",
            "plan",
            "show",
            "--resource-group",
            "{{host.resource_group}}",
            "--name",
            "{{host.plan}}",
            "--query",
            "{Name:name,Sku:sku.name,Tier:sku.tier,Workers:numberOfWorkers,Status:status}",
            "--output",
            "json"
          ]
        },
        {
          "id": "slots",
          "group": "Web app",
          "label": "Slots",
          "argv": [
            "webapp",
            "deployment",
            "slot",
            "list",
            "--resource-group",
            "{{host.resource_group}}",
            "--name",
            "{{host.app}}",
            "--query",
            "[].{Name:name,State:state,Host:defaultHostName}",
            "--output",
            "json"
          ]
        },
        {
          "id": "autoscale",
          "group": "Web app",
          "label": "Auto scale",
          "argv": [
            "monitor",
            "autoscale",
            "list",
            "--resource-group",
            "{{host.resource_group}}",
            "--query",
            "[].{Name:name,Enabled:enabled,Profiles:profiles[].{Min:capacity.minimum,Max:capacity.maximum,Default:capacity.default}}",

# Resolve every package as of this date (only matters when the lockfile is regenerated).
# Newer releases of the Radix UI family ship export maps that Parcel 2.16 cannot resolve
# ("Failed to resolve '@radix-ui/primitive/is-development'"), and @swc/core 1.16.12+ refuses to
# load where %LOCALAPPDATA% grants an AppContainer SID rights ("Failed to load native binding").
before=2026-05-31
